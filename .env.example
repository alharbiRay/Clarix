NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend — outbound RFQ invitation emails + inbound supplier PDF replies.
# RESEND_INBOUND_DOMAIN must be a receiving domain configured in the Resend
# dashboard (MX records), separate from the sending domain used in FROM.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_FROM_EMAIL=Clarix <noreply@clarix.website>
RESEND_INBOUND_DOMAIN=inbound.clarix.website

# Protects /api/jobs/process (background job sweep). Vercel Cron sends it
# automatically as a Bearer token; also set it as a GitHub Actions secret.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Demo workspace ("Try the demo"). The account is created by the seed script
# (npm run seed:demo) and flagged profiles.is_demo; it is read-only at the DB.
DEMO_ACCOUNT_EMAIL=demo@clarix.example
